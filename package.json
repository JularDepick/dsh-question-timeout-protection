{
  "name": "dsh-question-timeout-protection",
  "version": "0.1.2",
  "description": "dsh提问超时保护插件: 一旦模型提问超时,将你的回答草稿保留在UI或上下文中,而不是直接丢弃。",
  "type": "module",
  "author": "JularDepick",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JularDepick/dsh-question-timeout-protection.git"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <=0.2.2-rc.2"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "COPYRIGHT",
    "cordis.patch.yml",
    "src/translation/*.ini",
    "src/translation/.example_zh-CN.ini",
    "README*"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pack:release": "node scripts/check-translation.mjs && tsdown && pnpm pack --ignore-scripts && node scripts/pack-release.mjs --strict",
    "prepare": "node scripts/check-translation.mjs && tsdown",
    "prepack": "node scripts/check-translation.mjs && tsdown",
    "postpack": "node scripts/pack-release.mjs",
    "typecheck": "tsc --noEmit",
    "check:translation": "node scripts/check-translation.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.1 <=0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <=0.2.2-rc.2",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-rc.1 <=0.2.2-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "homepage": "https://github.com/JularDepick/dsh-question-timeout-protection#readme",
  "bugs": {
    "url": "https://github.com/JularDepick/dsh-question-timeout-protection/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "question",
    "timeout",
    "countdown"
  ]
}
