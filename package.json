{
  "name": "dsh-question-timeout-protection",
  "version": "0.1.0",
  "description": "为 dsh 提问等待提供界面增强与超时兜底: 右上角倒计时并在最后数秒红字闪烁,可暂停的无限等待,单选选中底色与提问标识气泡,超时后保留已输入内容并按配置决定是否注入上下文",
  "type": "module",
  "author": "JularDepick",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JularDepick/dsh-question-timeout-protection.git"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <=0.2.1-rc.3"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "COPYRIGHT",
    "cordis.patch.yml",
    "src/translation/*.ini",
    "src/translation/.example_zh-CN.ini",
    "README*",
    "scripts/"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pack:release": "tsdown && pnpm pack --ignore-scripts && node scripts/pack-release.mjs --strict",
    "prepack": "tsdown",
    "postpack": "node scripts/pack-release.mjs",
    "typecheck": "tsc --noEmit",
    "check:translation": "node scripts/check-translation.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "homepage": "https://github.com/JularDepick/dsh-question-timeout-protection#readme",
  "bugs": {
    "url": "https://github.com/JularDepick/dsh-question-timeout-protection/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "question",
    "timeout",
    "countdown"
  ]
}
